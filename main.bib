  author = {Cornwell, T J and Golap, K and Bhatnagar, S},
  abstract = {We present a novel interpretation of the non-coplanar baselines effect in synthesis radio telescopes as being due to differential Fresnel diffraction in the neighborhood of the array antennas, and a new algorithm to deal with this effect. Our new algorithm, which we call ``w projection'', has markedly superior performance compared to existing algorithms. At roughly equivalent levels of accuracy, w-projection can be up to an order of magnitude faster than the corresponding facet-based algorithms.},
