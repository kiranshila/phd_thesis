  urldate = {2024-06-12},
  abstract = {The complexity of computing an n-term Taylor polynomial using differentiation arithmetic is O(n2) compared with the exponentially growing complexity of expressions computed using symbolic differentiation. Differentiation arithmetic computes high order derivatives accurately compared with the notorious instability of numeric differentiation. Why does the topic of differentiation arithmetic arise so often in the context of interval algorithms? Point algorithms for Newton's method, optimization, numerical quadrature, etc., and interval algorithms for calculating function values, quadrature, solving ordinary differential equations, optimization, etc. require the accurate, efficient calculation of derivatives. Differentiation arithmetic meets this need. What is differentiation arithmetic? Differentiation arithmetic is a technique for computing derivatives of a function using recurrence relations; it is neither symbolic nor numeric. For example, let f(x) = 1+x2/ex We parse the expression into its primitive operations (square, add, square root, exponentiate, divide). For each operation, a procedure is called which computes derivatives accurately and efficiently using recurrence relations derived from the familiar rules of calculus. How is differentiation arithmetic applied? We illustrate the use of differentiation arithmetic for calculating interval bounds for ranges of functions and for validated numerical quadrature.},
  isbn = {978-0-12-505630-4},
  file = {/home/kshila/Zotero/storage/7PQJFHJU/B9780125056304500134.html}
}

