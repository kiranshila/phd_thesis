  shortjournal = {IEICE Trans. Commun.},
  volume = {E104.B},
  number = {8},
  pages = {922--933},
  issn = {0916-8516, 1745-1345},
  doi = {10.1587/transcom.2020EBI0002},
  url = {https://www.jstage.jst.go.jp/article/transcom/E104.B/8/E104.B_2020EBI0002/_article},
  urldate = {2025-04-22},
  abstract = {This paper reviews the evolutionary process that reduced the transmission loss of silica optical fibers from the report of 20 dB/km by Corning in 1970 to the current record-low loss. At an early stage, the main effort was to remove impurities especially hydroxy groups for fibers with GeO2-SiO2 core, resulting in the loss of 0.20 dB/km in 1980. In order to suppress Rayleigh scattering due to composition fluctuation, pure-silicacore fibers were developed, and the loss of 0.154 dB/km was achieved in 1986. As the residual main factor of the loss, Rayleigh scattering due to density fluctuation was actively investigated by utilizing IR and Raman spectroscopy in the 1990s and early 2000s. Now, ultra-low-loss fibers with the loss of 0.150 dB/km are commercially available in trans-oceanic submarine cable systems.},
